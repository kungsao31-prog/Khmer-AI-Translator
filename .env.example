# Configure these values in Render Dashboard > Environment.
# Never commit real credentials to GitHub.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
MAX_VIDEO_MB=200
MAX_SERIES_TOTAL_MB=200

# PostgreSQL connection string from Neon (or another persistent PostgreSQL provider).
DATABASE_URL=
# Generate a random secret of at least 32 characters; keep private.
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
ENABLE_REGISTRATION=true

# Initial administrator. Set a strong unique password (10-72 UTF-8 bytes).
ADMIN_EMAIL=
ADMIN_PASSWORD=

PORT=3000
